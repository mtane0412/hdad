{
  "manifest_version": 3,
  "name": "HDAD タブの映像",
  "version": "0.5.0",
  "description": "映したいタブで押すと、そのタブの映像と音を HDAD の合成ページへ送ります。映しているタブでもう一度押すと止めます。右クリックか設定で登録したサイトのページでは送るのを止めます。右クリックで、映す範囲をタブの一部分に絞れます。",
  "key": "",
  "permissions": ["tabCapture", "offscreen", "storage", "cookies", "webNavigation", "tabs", "contextMenus", "scripting", "activeTab"],
  "background": { "service_worker": "background.js", "type": "module" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "action": { "default_title": "このタブを配信に映す（HDAD）" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+T" },
      "description": "このタブを配信に映す・映しているタブなら止める"
    }
  }
}
