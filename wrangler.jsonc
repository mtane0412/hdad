/**
 * Cloudflare Workers の設定
 *
 * Viteのビルド出力を Workers 静的アセットとして配信し、/api/* だけを Worker のコード（worker/index.ts）で処理する。
 * これはビルドへの入力となる設定で、assets.directory は書かない。@cloudflare/vite-plugin がビルド時に
 * dist/hdad/wrangler.json を出力し、そこに静的アセットの場所（dist/client/）を書き込む。wrangler はそちらを使う。
 * 素材ページは <カテゴリ>/<id>/index.html の形の実ファイルで、末尾スラッシュなしのURLは html_handling によって末尾スラッシュ付きへリダイレクトさせる。
 * ページUI（/wallpaper/・/admin/ など）は実ファイルを持たず、not_found_handling によってトップの index.html を返してアプリに描かせる。
 * 存在しないパスでも index.html が返るので、「見つからない」画面はアプリが出す。
 *
 * STORE（KV）にはオーバーレイ用キー・アラートの設定を、MEDIA（R2）にはアラートの素材を、DB（D1）には配信の記録を保存する。
 * ALERTS（Durable Object）はオーバーレイとのWebSocketの接続を保持し、Workerが当てはめたアラートを配る（worker/alert-channel.ts）。
 * Durable Object はデプロイする人が用意するものではなく、migrations の指定から Cloudflare が作る（無料枠で使うため SQLite を土台にする）。
 * id やバケット名を書いていないのは、デプロイ時に wrangler が自動で作成して結び付けるため（フォークした人が書き換えずに済む）。
 * R2は無料枠だけを使う場合でも、事前にダッシュボードでR2を有効にしておく必要がある（docs/guide/deploy.md 参照）。
 * D1のテーブルは migrations/ にあり、デプロイとは別に適用する（docs/guide/stats.md 参照）。
 * triggers.crons は配信の記録の収集（worker/collect.ts）を5分おきに動かす。止めるときはキーを消すのではなく空の配列にする。
 * シークレット（TWITCH_CLIENT_ID など）の一覧は .dev.vars.example を参照。
 */
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hdad",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    // ASSETS は Worker から静的アセットを読むためのもの（拡張の zip を作るときに public/tab-extension/ のファイルを読む）
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [{ "binding": "STORE" }],
  "r2_buckets": [{ "binding": "MEDIA" }],
  "d1_databases": [{ "binding": "DB" }],
  // 文面づくり（チャットの文面・サイドスーパー・人物像・配信のあらすじ）と字幕の翻訳に使うLLM・翻訳専用モデル（Workers AI）。
  // 押した人が用意するものはないので、Deploy to Cloudflare ボタンの入力欄には出ない（Durable Object と同じ扱い）。
  // 呼び先は管理画面（/llm/）で OpenRouter に切り替えられる（そのときはシークレットOPENROUTER_API_KEYが要り、
  // このバインディングは呼ばれない。worker/llm.ts）。
  "ai": { "binding": "AI" },
  // ALERTS はオーバーレイへアラートを配る接続の保持、DRAW は描く画面と合成ページのあいだの手書きの線の中継（字幕も別の名前のインスタンスで同じものを使う）、
  // TAB は送り手のページ（/tab/）と合成ページのあいだのタブの映像の連絡（WebRTC の offer・answer）の中継、
  // AD_BREAKS は広告の終了の時刻を預かるタイマー、COMMENTS はコメントビューアーへチャットと出来事を配る接続の保持
  // （Workerは接続もタイマーも持てない）。TOKENS はTwitchのトークンの保管庫（更新と切断・付け替えを食い違わせないため。worker/token-vault.ts）。
  // どれも押した人が用意するものはないので入力欄には出ない
  "durable_objects": {
    "bindings": [
      { "name": "ALERTS", "class_name": "AlertChannel" },
      { "name": "DRAW", "class_name": "DrawChannel" },
      { "name": "TAB", "class_name": "TabChannel" },
      { "name": "AD_BREAKS", "class_name": "AdBreakTimer" },
      { "name": "COMMENTS", "class_name": "CommentChannel" },
      { "name": "TOKENS", "class_name": "TokenVault" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AlertChannel"] },
    { "tag": "v2", "new_sqlite_classes": ["AdBreakTimer"] },
    { "tag": "v3", "new_sqlite_classes": ["DrawChannel"] },
    { "tag": "v4", "new_sqlite_classes": ["CommentChannel"] },
    { "tag": "v5", "new_sqlite_classes": ["TabChannel"] },
    { "tag": "v6", "new_sqlite_classes": ["TokenVault"] }
  ],
  "triggers": { "crons": ["*/5 * * * *"] }
}
