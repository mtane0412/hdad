/**
 * ブラウザ向け（src/）の型チェック設定
 *
 * Worker（worker/）は Cloudflare のランタイムの型（@cloudflare/workers-types）を使い、DOMの型とは同時に読めないため、
 * tsconfig.worker.json に分けてある。npm run type-check は両方を走らせる。
 */
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "jsx": "react-jsx",
    "paths": { "@/*": ["./src/*"] },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "vite.config.ts", "eslint.config.js"]
}
